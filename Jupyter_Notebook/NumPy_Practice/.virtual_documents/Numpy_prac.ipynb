### Reshapeing

arr7= np.array([[1,2,3],[4,5,6]])
print(arr7,arr7.shape)
reshape_arr7=arr7.reshape((3,2))
print(reshape_arr7,reshape_arr7.shape)
flat_arr7= arr7.flatten()
print(flat_arr7,flat_arr7.shape)


### Indexing
arr8= np.array([[1,5,6],[8,7,9]])
print(arr8[1][2])
arr9=np.array([1,2,6,5,4,8,6])
### fancy indexing
idx=[1,2,4]
print(arr9[idx])

### boolean
print(arr9[arr9>4])
print(arr9[arr9 % 2 == 0])
print(arr9[arr9 % 2 != 0])

### slicing
print(arr9[1:4])
print(arr9[::2])



